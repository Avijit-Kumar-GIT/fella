# Fixed acceptance cases for no-workspace routing; phrase checks are screening
# criteria, and the references also require a human check for unsupported claims.
{"id":"ask-routing-local-data-needs-folder","question":"What was my total rent spending last year?","workspace_scope":"none","files":[],"category":"ask_routing","gold":{"contains":["folder|workspace","open|mount|select"]},"reference":"Do not invent a personal spending total or imply that files were inspected. Explain that no workspace is open and ask the user to open or mount the relevant folder."}
{"id":"ask-routing-mixed-general-and-local","question":"Explain what a year-over-year change means, and tell me whether my rent increased this year.","workspace_scope":"none","files":[],"category":"ask_routing","gold":{"contains":["year-over-year|same period|year to year","rent","folder|workspace","open|mount|select"]},"reference":"Briefly explain year-over-year comparison, then say that determining the user's rent change requires a mounted workspace. Do not invent a personal result."}
{"id":"ask-routing-followup-context","question":"Why is the latter less sensitive to one very large value?","workspace_scope":"none","files":[],"category":"ask_routing","setup_turns":["What is the difference between the mean and the median?"],"gold":{"contains":["median","outlier|large|extreme","mean|average"]},"reference":"Resolve 'the latter' to the median from the preceding turn, and explain its resistance to an outlier relative to the mean."}
