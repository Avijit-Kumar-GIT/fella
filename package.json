{
	"name": "fella",
	"private": true,
	"version": "0.2.0",
	"main": "electron/main.mjs",
	"description": "Ask questions about your own files",
	"author": "Avijit Kumar and contributors",
	"license": "MIT",
	"packageManager": "pnpm@11.24.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"electron:build": "pnpm build && cargo build --release --manifest-path src-tauri/Cargo.toml && node electron/prepare-engine.mjs",
		"electron:dev": "pnpm electron:build && node electron/dev.mjs",
		"electron:run": "pnpm electron:build && electron electron/main.mjs",
		"electron:package": "pnpm electron:build && electron-builder",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"tauri": "tauri"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tauri-apps/cli": "^2.11.4",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.2.0",
		"electron": "42.3.3",
		"electron-builder": "26.15.2",
		"svelte": "^5.57.0",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"build": {
		"appId": "dev.fella.app",
		"productName": "Fella",
		"asar": true,
		"files": ["build/**/*", "electron/**/*", "package.json"],
		"extraResources": [{ "from": "electron/engine", "to": "fella-engine" }],
		"directories": { "output": "dist-electron" },
		"mac": { "target": ["dmg", "zip"], "category": "public.app-category.productivity" },
		"win": { "target": ["nsis", "msi"] },
		"linux": { "target": ["AppImage", "deb"], "category": "Utility" }
	},
	"dependencies": {
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-dialog": "^2.7.3",
		"@tauri-apps/plugin-opener": "^2.5.5",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"marked": "^18.0.13"
	}
}
