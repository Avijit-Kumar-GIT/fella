          },
          {
            "group": "Workspace",
            "icon": "folder-open",
            "pages": [
              "developer-platform/using-fella/open-folder",
              "developer-platform/using-fella/files",
              "developer-platform/using-fella/context-and-memory"
            ]
          },
          {
            "group": "Ask and inspect",
            "icon": "search-check",
            "pages": [
              "developer-platform/using-fella/asking-questions",
              "developer-platform/using-fella/evidence"
            ]
          },
          {
            "group": "Models and sessions",
            "icon": "cpu",
            "pages": [
              "developer-platform/using-fella/models",
              "developer-platform/using-fella/sessions"
            ]
          },
          {
            "group": "Extensions",
            "icon": "puzzle",
            "pages": ["extensions-and-mcp"]
          }
        ]
      },
      {
