{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "fella | Developer Documentation",
  "description": "How fella is built: the harness, the engine, and the model, for contributors.",
  "colors": {
    "primary": "#3fc7bc",
    "light": "#74d8cf",
    "dark": "#3fc7bc"
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "format": "woff2"
    },
    "body": {
      "family": "Geist",
      "format": "woff2"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "chatgpt", "claude"]
  },
  "logo": "/logo.svg",
  "favicon": "/favicon.svg",
  "navbar": {
    "links": [
      {
        "label": "Changelog",
        "href": "https://github.com/Avijit-Kumar-GIT/fella/blob/main/CHANGELOG.md"
      },
      {
        "label": "Support",
        "href": "https://github.com/Avijit-Kumar-GIT/fella/issues"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get fella",
      "href": "https://fella.app"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Overview",
        "icon": "house",
        "pages": ["index"]
      },
      {
        "tab": "Developer Platform",
        "icon": "code",
        "anchors": [
          {
            "anchor": "Guide",
            "icon": "compass",
            "pages": [
              "getting-started",
              {
                "group": "Concepts",
                "icon": "layers",
                "pages": [
                  "concepts/architecture",
                  "concepts/harness",
                  "concepts/engine",
                  "concepts/verification",
                  "concepts/model-layer"
                ]
              }
            ]
          },
          {
            "anchor": "Reference",
            "icon": "terminal",
            "pages": [
              {
                "group": "Tools & commands",
                "icon": "wrench",
                "pages": ["concepts/tools", "developer-platform/using-fella"]
              },
              {
                "group": "Other resources",
                "icon": "book-open",
                "pages": [
                  "other-resources/benchmarks",
                  "other-resources/evaluation",
                  "other-resources/contributing"
                ]
              }
            ]
          }
        ]
      },
      {
        "tab": "Extensions and MCP",
        "icon": "puzzle",
        "pages": ["extensions-and-mcp"]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Avijit-Kumar-GIT/fella"
    }
  }
}
