{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "fella",
  "description": "Documentation for Fella, a local-first desktop app for asking auditable questions about your own files.",
  "seo": {
    "metatags": {
      "canonical": "https://docs.lilfella.app"
    }
  },
  "colors": {
    "primary": "#3fc7bc",
    "light": "#74d8cf",
    "dark": "#3fc7bc"
  },
  "favicon": "/favicon.svg",
