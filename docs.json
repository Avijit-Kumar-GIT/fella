        "href": "https://github.com/Avijit-Kumar-GIT/fella/releases"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Download Fella",
      "href": "https://github.com/Avijit-Kumar-GIT/fella/releases/latest"
    }
  },
